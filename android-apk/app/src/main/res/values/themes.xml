<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.ChefModeApp.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/chef_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/chef_bg</item>
        <item name="postSplashScreenTheme">@style/Theme.ChefModeApp</item>
    </style>

    <style name="Theme.ChefModeApp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/chef_primary</item>
        <item name="android:statusBarColor">@color/chef_bg</item>
        <item name="android:navigationBarColor">@color/chef_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>
</resources>
